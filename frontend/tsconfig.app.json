// TypeScript settings for the app code in src/. Strict mode is on so type errors fail the build (and CI).
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // vite/client: import.meta.env and asset imports. vite-plugin-pwa/client: the PWA's virtual modules.
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,

    // Bundler mode: Vite resolves imports, tsc only type-checks.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // Strictness.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // "@/..." import alias (matches vite.config.ts).
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
