// Root TypeScript config: splits the project into app code (src/) and build-tool code (vite.config.ts).
// `npm run build` type-checks both with `tsc -b` before bundling.
{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Lets editors and shadcn resolve the "@/..." import alias.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  }
}
