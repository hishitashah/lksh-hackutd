# Backend settings. Copy to `.env` in the repo root (it's gitignored) and fill in your own values.
# Read by backend/nightwatch/config.py. Every setting is documented there.

# --- Data -----------------------------------------------------------------
# Folders scanned for datasets (each needs network.json, ops.json, telemetry.csv).
DATA_DIRS=history,test

# --- Mock mode ------------------------------------------------------------
# 1 = serve fixtures/ while the real engine is being built. MUST be 0 for the demo.
NIGHTWATCH_MOCK=1

# --- NVIDIA Nemotron (Sentinel) ---------------------------------------------
# Free key: https://build.nvidia.com . Then run `make check-nvidia` to confirm the model names.
NVIDIA_API_KEY=
SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
SUPER_BASE_URL=https://integrate.api.nvidia.com/v1
# Switch to your Brev vLLM server once it's running (T5.8), e.g. http://<brev-host>:8000/v1
NANO_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Field-crew notifications (T5.5) ----------------------------------------
# ntfy.sh topic for phone pushes: pick a long random name (topics are public).
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
