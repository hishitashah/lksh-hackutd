# Backend settings. Copy to `.env` in the repo root (it's gitignored) and fill in your own values.
# Read by backend/nightwatch/config.py. Every setting is documented there.

# --- Data -----------------------------------------------------------------
# Folders scanned for datasets (each needs network.json, ops.json, telemetry.csv).
DATA_DIRS=history,test

# --- Mock mode ------------------------------------------------------------
# 1 = serve fixtures/ while the real engine is being built. MUST be 0 for the demo.
NIGHTWATCH_MOCK=1

# --- NVIDIA Nemotron (agents + orchestrator) --------------------------------
# Free key: https://build.nvidia.com . Then run `make check-nvidia ARGS=--ping`.
# Not every listed model is enabled for every account: if a model says "not found for account", pick another
# Nemotron model from the list that answers the ping.
NVIDIA_API_KEY=
SUPER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Nemotron 3 "thinking" before answering: off = ~1 s answers, on = ~6-9 s.
NEMOTRON_THINKING=0
SUPER_BASE_URL=https://integrate.api.nvidia.com/v1
# Switch to your Brev vLLM server once it's running (T5.8), e.g. http://<brev-host>:8000/v1
NANO_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Field-crew notifications (T5.5) ----------------------------------------
# Orders reach phones through the app's own live /field page (no setting needed).
# Optional: Discord webhook for the on-screen dispatch log.
DISCORD_WEBHOOK_URL=

# --- Work orders on GitHub Issues (T5.13) -----------------------------------
# Fine-grained token with Issues read/write on ONE repo only. Use a separate demo repo for work orders.
GITHUB_TOKEN=
GITHUB_REPO=owner/name
